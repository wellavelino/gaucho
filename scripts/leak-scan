#!/usr/bin/env bash
# Fail if a tracked file holds something that should never be published.
# The patterns are generic, so this file names no real person or machine.
set -uo pipefail

cd "$(dirname "$0")/.."
status=0

check() {
  local label=$1 pattern=$2 hits
  hits=$(git ls-files -co --exclude-standard -z |
    grep -zv -e '^scripts/leak-scan$' -e '^LICENSE$' |
    xargs -0 grep -nIE -- "$pattern" 2>/dev/null)
  if [[ -n $hits ]]; then
    printf 'Possible %s:\n%s\n\n' "$label" "$hits"
    status=1
  fi
}

check "home directory" '/(home|Users)/[a-z][a-z0-9_-]+/'
check "private address" '\b(10\.[0-9]+\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+)\b'
check "email address" '[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\.(com|org|net|io|dev|co|me|edu|gov)\b'
check "private key" 'BEGIN [A-Z ]*PRIVATE KEY'
check "access token" '\b(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16})\b'
check "secret assignment" '(password|passwd|api[_-]?key|secret|token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'$]{8,}'

for file in $(git ls-files -co --exclude-standard | grep -E '(^|/)(\.env|config\.env|.*\.pem|id_rsa|id_ed25519)$'); do
  echo "Private file: $file"
  status=1
done

[[ $status == 0 ]] && echo "No leaks found."
exit "$status"
